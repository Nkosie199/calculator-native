{
  "expo": {
    "name": "calculator",
    "slug": "calculator",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6236ff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6236ff"
      },
      "package": "com.mynger.calculator"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "mynger",
    "extra": {
      "eas": {
        "projectId": "bb774e63-eb24-477d-9c9e-790d27e37148"
      }
    },
    "newArchEnabled": false,
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#6236ff",
          "imageWidth": 200
        }
      ]
    ]
  },
  "version": "1.0.1"
}
